DATABASE_URL=postgres://user:password@localhost:5432/exam_integrity
# REQUIRED in production (16+ chars). Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000

# Where webcam snapshots are stored. Use a persistent volume / in-country storage mount in production.
UPLOADS_DIR=./uploads

# Moodle / LMS integration (LTI 1.1) - leave unset to disable
LTI_CONSUMER_KEY=examtech
LTI_SHARED_SECRET=change-me
PUBLIC_API_URL=https://your-api-host
CLIENT_URL=https://your-client-host
# LTI_INSTITUTION_ID=1
